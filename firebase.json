{
  "functions": [
    {
      "source": "backend/functions",
      "codebase": "solary",
      "predeploy": ["npm --prefix backend/functions run build"]
    }
  ],
  "storage": {
    "rules": "backend/storage/storage.rules"
  },
  "firestore": {
    "rules": "backend/firestore/firestore.rules",
    "indexes": "backend/firestore/firestore.indexes.json"
  },
  "hosting": [
    {
      "target": "admin",
      "public": "apps/web-admin/out",
      "cleanUrls": true,
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "headers": [
        {
          "source": "**",
          "headers": [
            { "key": "X-Frame-Options", "value": "DENY" },
            { "key": "X-Content-Type-Options", "value": "nosniff" },
            { "key": "Referrer-Policy", "value": "same-origin" },
            { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
          ]
        }
      ]
    },
    {
      "target": "vendor",
      "public": "apps/web-vendor/out",
      "cleanUrls": true,
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "headers": [
        {
          "source": "**",
          "headers": [
            { "key": "X-Frame-Options", "value": "DENY" },
            { "key": "X-Content-Type-Options", "value": "nosniff" },
            { "key": "Referrer-Policy", "value": "same-origin" },
            { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
          ]
        }
      ]
    },
    {
      "target": "storefront",
      "public": "apps/web-storefront/out",
      "cleanUrls": true,
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "headers": [
        {
          "source": "**",
          "headers": [
            { "key": "X-Frame-Options", "value": "DENY" },
            { "key": "X-Content-Type-Options", "value": "nosniff" },
            { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
            { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
          ]
        }
      ]
    }
  ],
  "emulators": {
    "auth": { "port": 9099 },
    "functions": { "port": 5001 },
    "firestore": { "port": 8080 },
    "hosting": { "port": 5000 },
    "storage": { "port": 9199 },
    "ui": { "enabled": true }
  }
}
