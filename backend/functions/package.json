{
  "name": "@solary/functions",
  "private": true,
  "version": "0.0.1",
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc -w",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "test": "tsc && node --test test/*.test.js",
    "test:emulator": "tsc && firebase emulators:exec --project demo-solary --only auth,firestore,functions \"node --test test/emulator/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0",
    "nodemailer": "^10.0.13"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/nodemailer": "^8.0.2",
    "typescript": "^5.4.0"
  }
}
